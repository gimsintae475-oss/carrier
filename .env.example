# 로컬 production build와 Render에서 사용하는 공개 설정입니다.
# 아래 두 값만 프런트엔드 빌드에 주입합니다.
# service_role, sb_secret_*, SUPABASE_SECRET_KEY는 절대로 등록하지 마세요.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# 날씨는 API 키가 필요 없는 Open-Meteo를 사용하며 서울 좌표는 빌드 설정에 포함됩니다.
